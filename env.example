# ════════════════════════════════════════════════════════════
#  Daylung — переменные окружения
#  Скопируйте в .env и заполните. Файл .env в git не попадает.
# ════════════════════════════════════════════════════════════

# ── Сервер ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Публичный адрес, используется в ссылках предпросмотра
APP_URL=http://localhost:3000

# ── Администратор ────────────────────────────────────────────
# ВАЖНО: смените пароль перед публикацией в интернет.
ADMIN_USER=owner
ADMIN_PASSWORD=daylung-dev-2026

# Секрет для подписи сессионных cookie.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Время жизни сессии в часах
SESSION_TTL_HOURS=12

# ── AI-провайдер ─────────────────────────────────────────────
# mock — локальный подбор по правилам, работает без интернета и ключей.
# Будущие значения: openai | anthropic | yandex | custom
AI_PROVIDER=mock

# Ключ хранится ТОЛЬКО здесь. Никогда не коммитится в репозиторий.
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000

# ── Партнёрские ссылки ───────────────────────────────────────
# Включает редирект через /go/:id с записью клика
AFFILIATE_TRACKING=on

# ── Хранилище ───────────────────────────────────────────────
# Каталог с JSON-данными (относительно корня проекта)
DATA_DIR=data

# ── Хранилище ────────────────────────────────────────────────────────────
# file     — JSON-файлы в DATA_DIR (локальная разработка, по умолчанию)
# postgres — PostgreSQL по DATABASE_URL (production, Vercel)
DB_DRIVER=file

# Строка подключения. Только из переменных окружения, никогда в коде.
# Пример: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=
